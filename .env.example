# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
# Use this same database name for the License Manager deployment.
MONGO_DB_NAME=forgeqa

# Security & Authentication
JWT_SECRET=your-jwt-secret-at-least-32-chars
ENCRYPTION_SECRET=your-32-character-encryption-secret

# PBKDF2 Hashing Iterations (Default: 210000 for SHA-512 per OWASP recommendation)
PBKDF2_ITERATIONS=210000

# Application URLs & Support
APP_URL=http://127.0.0.1:5173
SUPPORT_EMAIL=support@forgeqa.in

# Email Service (Optional: Resend or SMTP)
RESEND_API_KEY=
RESEND_FROM=ForgeQA <noreply@forgeqa.in>

# Billing & Payments Provider Configuration
# Set to 'fake' for offline local dev/testing with zero network calls, or 'stripe'
# BILLING_PROVIDER=fake
# BILLING_GRACE_PERIOD_DAYS=7

# Stripe Configuration
# STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_placeholder
# STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
# STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly
# STRIPE_TEAM_MONTHLY_PRICE_ID=price_team_monthly
# STRIPE_ENTERPRISE_PRICE_ID=price_enterprise

# Razorpay Configuration (Alternative for INR)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
