# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=forgeqa

# Security & Authentication
JWT_SECRET=your-jwt-secret-at-least-32-chars
ENCRYPTION_SECRET=your-32-character-encryption-secret

# PBKDF2 Hashing Iterations (Default: 210000 for SHA-512 per OWASP recommendation)
PBKDF2_ITERATIONS=210000

# Application URLs & Support
APP_URL=http://127.0.0.1:5173
SUPPORT_EMAIL=support@forgeqa.in

# Email Service (Optional: Resend or SMTP)
RESEND_API_KEY=
RESEND_FROM=ForgeQA <onboarding@resend.dev>

# Optional Stripe Pricing
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
